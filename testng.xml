<suite name="Book Store Automation Suite" verbose="1">

    <listeners>
        <!-- Retries a test once, only for browser infrastructure failures (see InfraRetryAnalyzer) -->
        <listener class-name="listener.RetryTransformer"/>
    </listeners>

    <test name="E2E Tests" parallel="classes" thread-count="2">
        <packages>
            <package name="tests.e2e"/>
        </packages>
    </test>

    <test name="UI Tests" parallel="classes" thread-count="2">
        <packages>
            <package name="tests.ui"/>
        </packages>
    </test>

    <test name="API Tests" parallel="methods" thread-count="2">
        <packages>
            <package name="tests.api"/>
        </packages>
    </test>

</suite>